---
import { site, whatsappHref } from "../config/site";
---

<a
  class="wa-float"
  href={whatsappHref()}
  aria-label={`Escribir a Zappy Delivery por WhatsApp al ${site.whatsappDisplay}`}
>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"
      stroke-linecap="round"
      d="M12 4.5a7.2 7.2 0 0 0-6.2 10.9L4.5 19.5l4.2-1.2A7.2 7.2 0 1 0 12 4.5Z"
    ></path>
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      d="M9.2 10.2c.3 2 2.1 3.5 3.7 3.8"
    ></path>
  </svg>
  <span class="wa-float-label">WhatsApp</span>
</a>
